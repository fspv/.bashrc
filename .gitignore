# Junk that can appear anywhere in the tree
*~
*.swo
*.swp
*.pyc
__pycache__/
.DS_Store
.mypy_cache/
flake.lock
.env*
.zcompdump*
.zsh_history
nohup.out

# Ignore everything in $HOME, whitelist tracked entries.
# Directories manage their own contents via their own .gitignore.
/*
!/.gitignore
!/.XCompose
!/.agents
!/.bash_profile
!/.bashrc
!/.cache/
!/.claude/
!/.config/
!/.editorconfig
!/.envrc
!/.github/
!/.isort.cfg
!/.kube/
!/.local/
!/.luacheckrc
!/.pam_environment
!/.parallel/
!/.pre-commit-config.yaml
!/.psqlrc
!/.ssh/
!/.sshrc
!/.sshrc.d/
!/.stylua.toml
!/.var/
!/.zshenv
!/README.md
!/apps/
!/flake.nix
!/pyproject.toml
!/requirements-dev.txt
!/requirements.txt
!/venv/
