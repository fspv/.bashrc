#!/usr/bin/env bash
set -eu
temp_dir=$(mktemp -d)
trap 'rm -rf "$temp_dir"' EXIT
git archive "$(git write-tree)" | tar -x -C "$temp_dir"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR
git -C "$temp_dir" init --quiet
git -C "$temp_dir" add -A -f
git -C "$temp_dir" -c user.email=pre-commit -c user.name=pre-commit commit --quiet --no-verify -m staged
# shellcheck disable=SC2046 # actrc contents are split into separate act flags on purpose
act -C "$temp_dir" $(< .config/act/actrc) "$@"
